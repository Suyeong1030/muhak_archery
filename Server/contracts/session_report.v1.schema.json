{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artemis.local/contracts/session_report.v1.schema.json",
  "title": "ARTEMIS Session Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "payload"],
  "properties": {
    "type": {"const": "session_report"},
    "payload": {"$ref": "#/$defs/payload"}
  },
  "$defs": {
    "sensorAvailability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pose", "polar_h10", "respiration"],
      "properties": {
        "pose": {"type": "boolean"},
        "polar_h10": {"type": "boolean"},
        "respiration": {"type": "boolean"}
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_index", "kind", "trial_number", "url",
        "mime_type", "width", "height"
      ],
      "properties": {
        "page_index": {"type": "integer", "minimum": 0},
        "kind": {"enum": ["summary", "sensor", "trial"]},
        "trial_number": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "url": {
          "type": "string",
          "pattern": "^(https?://|/).+"
        },
        "mime_type": {"const": "image/png"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "trial"}}},
          "then": {"properties": {"trial_number": {"type": "integer"}}},
          "else": {"properties": {"trial_number": {"type": "null"}}}
        }
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_version", "session_id", "code", "message",
        "shot_count", "total_score", "average_score", "strengths",
        "weaknesses", "recommendations", "sensor_availability", "pages"
      ],
      "properties": {
        "report_version": {"const": 1},
        "session_id": {"type": "string", "minLength": 1, "maxLength": 100},
        "code": {"const": "SESSION_REPORT"},
        "message": {"type": "string", "minLength": 1},
        "shot_count": {"type": "integer", "minimum": 1},
        "total_score": {"type": "integer", "minimum": 0},
        "average_score": {"type": "number", "minimum": 0},
        "strengths": {"type": "array", "items": {"type": "string"}},
        "weaknesses": {"type": "array", "items": {"type": "string"}},
        "recommendations": {"type": "array", "items": {"type": "string"}},
        "sensor_availability": {"$ref": "#/$defs/sensorAvailability"},
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/page"}
        }
      }
    }
  }
}
